# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code and config files
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files (prevent any line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
